# Exemplo de variáveis de ambiente para o Sharp MSSQL MCP
# Copie este arquivo para .env e preencha os valores reais

SQL_PROD_USER=seu_usuario
SQL_PROD_PASSWORD=sua_senha
SQL_ANALYTICS_USER=usuario_analytics
SQL_ANALYTICS_PASSWORD=senha_analytics
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=sua_secret_aqui
